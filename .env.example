# OpenAI-compatible LLM endpoint used by the extraction/resolution pipeline.
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this template is committed as a reference.
#
# The model name is never hardcoded in code: it is read from LLM_MODEL_ID at
# runtime and passed to a generic `openai-generic` BAML client.
LLM_BASE_URL=https://your-endpoint.example.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL_ID=your-model-name

# The agent reasoning role reads the same LLM_* vars above by default
# (AgentLLMSettings.from_openai_compatible_env). Set AGENT_LLM_* to give the
# agent its own endpoint, model, or key instead.

# Optional: configure the extraction LLM role directly with EXTRACTION_LLM_*
# vars instead of the LLM_* convenience vars above. These accept a JSON list
# of client configs and compose per `strategy`.
# EXTRACTION_LLM_CLIENTS=[{"name": "c", "provider": "openai-generic", "model": "your-model-name", "base_url": "https://your-endpoint.example.com/v1", "api_key": "your-api-key"}]
# EXTRACTION_LLM_STRATEGY=single

# Optional: how long an add/update/delete_document call's lease on a document
# stays valid before another worker may take the document over. Seconds.
# CUTOVER_JOB_LEASE_TTL_SECONDS=60

# Optional: the eval judge (agrag.eval.EvalJudgeSettings). It reads the LLM_*
# vars above unless EVAL_JUDGE_* is set, so by default the agent's own model
# grades its answers. Set EVAL_JUDGE_* to grade with a different model. The
# judge runs at temperature 0. Set EVAL_JUDGE_TEMPERATURE empty to send no
# temperature, for models that reject it.
# EVAL_JUDGE_BASE_URL=https://your-endpoint.example.com/v1
# EVAL_JUDGE_API_KEY=your-api-key
# EVAL_JUDGE_MODEL_ID=your-judge-model-name
# EVAL_JUDGE_TEMPERATURE=0.0
