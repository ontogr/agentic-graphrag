# OpenAI-compatible LLM endpoint used by the extraction/resolution pipeline.
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this template is committed as a reference.
#
# The model name is never hardcoded in code: it is read from LLM_MODEL_ID at
# runtime and passed to a generic `openai-generic` BAML client.
LLM_BASE_URL=https://your-endpoint.example.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL_ID=your-model-name

# Optional: configure the extraction LLM role directly with EXTRACTION_LLM_*
# vars instead of the LLM_* convenience vars above. These accept a JSON list
# of client configs and compose per `strategy`.
# EXTRACTION_LLM_CLIENTS=[{"name": "c", "provider": "openai-generic", "model": "your-model-name", "base_url": "https://your-endpoint.example.com/v1", "api_key": "your-api-key"}]
# EXTRACTION_LLM_STRATEGY=single
